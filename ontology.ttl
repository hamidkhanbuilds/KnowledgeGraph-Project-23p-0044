@prefix kg:   <http://example.org/kg/23p-0044/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/kg/23p-0044/ontology> a owl:Ontology ;
    rdfs:label "Physicist biography ontology (23P-0044)" .

kg:Person       a owl:Class ; rdfs:label "Person" .
kg:Place        a owl:Class ; rdfs:label "Place" .
kg:Organization a owl:Class ; rdfs:label "Organization" .
kg:Award        a owl:Class ; rdfs:label "Award" .

kg:Person       owl:disjointWith kg:Place , kg:Organization , kg:Award .
kg:Place        owl:disjointWith kg:Organization , kg:Award .
kg:Organization owl:disjointWith kg:Award .

kg:bornIn a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "born in" ;
    rdfs:domain kg:Person ; rdfs:range kg:Place .

kg:educatedAt a owl:ObjectProperty ;
    rdfs:label "educated at" ;
    rdfs:domain kg:Person ; rdfs:range kg:Organization .

kg:receivedAward a owl:ObjectProperty ;
    rdfs:label "received award" ;
    rdfs:domain kg:Person ; rdfs:range kg:Award .

kg:worksAt a owl:ObjectProperty ;
    rdfs:label "works at" ;
    rdfs:domain kg:Person ; rdfs:range kg:Organization .

kg:doctoralAdvisor a owl:ObjectProperty ;
    rdfs:label "doctoral advisor" ;
    rdfs:domain kg:Person ; rdfs:range kg:Person .

    kg:doctoralAdvisor kg:Waleed_Gilani ;
    kg:educatedAt kg:Calder_University,
        kg:Westmere_Institute_of_Technology ;
    kg:receivedAward kg:Northgate_Prize ;
    kg:worksAt kg:Larkspur_College_of_Science .

kg:James_Chadwick a kg:Person ;
    rdfs:label "James Chadwick" ;
    kg:bornIn kg:Cheshire ;
    kg:educatedAt kg:Caius_College,
        kg:Central_Grammar_School_for_Boys,
        kg:Gonville,
        kg:Victoria_University_of_Manchester ;
    kg:receivedAward kg:Exhibition_Scholarship,

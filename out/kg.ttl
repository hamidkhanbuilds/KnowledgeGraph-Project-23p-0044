kg:Ernest_Rutherford a kg:Person ;
    rdfs:label "Ernest Rutherford" ;
    kg:worksAt kg:Cavendish_Laboratory,
        kg:University_of_Cambridge .

kg:Erwin_Schr%C3%B6dinger a kg:Person ;
    rdfs:label "Erwin Schrödinger" ;
    kg:bornIn kg:TU_Wien ;
    kg:receivedAward kg:Haitinger_Prize_of_Austrian_Academy_of_Sciences,
        kg:Nobel_Prize_in_Physics ;
    kg:worksAt kg:Dublin_Institute_for_Advanced_Studies,
        kg:Princeton_University,
        kg:University_of_Jena,
        kg:University_of_Zurich .

kg:Faryal_Awan a kg:Person ;
